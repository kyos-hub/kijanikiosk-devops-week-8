# ---- Stage 1: build ----
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies first for better layer caching
COPY package*.json ./
RUN npm ci

# Copy source and build (TypeScript -> JS, if applicable)
COPY . .
RUN npm run build

# Prune dev dependencies so only production deps remain
RUN npm prune --production
RUN mkdir -p node_modules

# ---- Stage 2: runtime ----
FROM node:20-alpine AS runtime

# Create a non-root user/group to run the app
RUN addgroup -S kijani && adduser -S kijani -G kijani

WORKDIR /app

# Only copy what's needed to run: production node_modules + built output
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package*.json ./

# Drop privileges
USER kijani

ENV NODE_ENV=production
EXPOSE 3000

# HEALTHCHECK: give the app time to init its connection pool before
# judging it unhealthy (see Challenge E — 30s start-period is the safe default)
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/health || exit 1

# Exec-form CMD (no shell wrapping, proper signal handling)
CMD ["node", "dist/server.js"]
